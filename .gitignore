# Credential material — must never be committed to this public repository.
# Google service-account key used for Drive results upload
# (google.drive.service.account.key.file in src/test/resources/appProperties.properties).
yeloautomationresultsdrive-*.json
Credentials/

# Maven build output — regenerated by every build; committing it caused
# binary merge conflicts on .class files.
target/
ejarautomation-playwright/target/
ejarautomation-playwright/.idea/

# Playwright MCP runtime output - page snapshots, console logs and screenshots
# written by the MCP browser during a run (McpPlaywrightClient / the 'AI MCP' feature).
**/playwright-mcp/
**/.playwright-mcp/

# AI Agent credentials - DeepSeek API key used by the AI validation steps.
# Never commit; DeepSeekVisionValidator reads it at runtime.
**/AI Agent Credentials/
